# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Virtual environment
venv/
env/
.venv/

# OS files
.DS_Store
Thumbs.db

# Secrets. These files hold API keys and must never reach the repository -
# public repos are scanned by bots within minutes of a push.
.env
.env.*
.streamlit/secrets.toml

# Raw and processed datasets - freely downloadable, too large to commit.
# Recreate with: python scripts/download_data.py
data/raw/*.csv
data/processed/*.csv

# Trained models. The deployable bundles are small enough to commit if the
# Streamlit demo needs to run without a training step; everything else is
# regenerated by `python main.py`.
models/*.keras
models/*_logistic_regression.joblib
models/*_linear_svm.joblib
models/*_gradient_boosting.joblib
*.pkl
